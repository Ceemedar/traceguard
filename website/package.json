    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@types/leaflet": "1.9.20",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
